pkgname=scicalc
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first scientific calculator for one-off sums'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/scicalc "$pkgdir/usr/bin/scicalc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/scicalc.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/scicalc.svg"
  install -Dm644 "$startdir/scicalc.desktop" "$pkgdir/usr/share/applications/scicalc.desktop"
}
